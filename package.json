{
  "name": "plaintyped",
  "version": "1.2.0",
  "description": "Find and remove invisible Unicode characters, hidden AI watermarks, look-alike letters, and AI typography tells from text. Runs in the browser or from the command line.",
  "license": "MIT",
  "main": "cleaner.js",
  "browser": "cleaner.js",
  "bin": {
    "plaintyped": "bin/plaintyped.js"
  },
  "files": [
    "cleaner.js",
    "tells.js",
    "index.html",
    "bin/"
  ],
  "scripts": {
    "test": "node --test test/cleaner.test.js",
    "start": "node scripts/serve.js",
    "build": "node scripts/build.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "unicode",
    "zero-width",
    "invisible-characters",
    "watermark",
    "ai-text",
    "homoglyph",
    "text-cleaner"
  ]
}
